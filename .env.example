# Directory (inside the container) where Groovarr stores its SQLite database, secrets, and settings.
CONFIG_DIR=/config

# Directory (inside the container) where the final, organized music-video library is written.
MEDIA_DIR=/music-videos

# Directory (inside the container) used as scratch space while downloading/processing before import.
DOWNLOADS_DIR=/downloads

# Port the Groovarr web UI / API listens on inside the container.
PORT=8080

# Log verbosity: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# Random secret used to derive the at-rest encryption key for stored credentials (Spotify/Jellyfin/Plex). Generate a long random value and keep it stable across restarts.
GROOVARR_SECRET_KEY=

# Spotify app Client ID. Client ID + Client Secret alone (no user login) are enough to read public/unlisted playlists via the default Client Credentials Flow — create a free app in the Spotify Developer Dashboard (Development Mode) to get these.
SPOTIFY_CLIENT_ID=

# Spotify app Client Secret (see SPOTIFY_CLIENT_ID above). Only needed alongside a user login (optional "Connect your Spotify account" feature in Settings) for private/collaborative playlists.
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 key (free, from Google Cloud Console) used for reliable video discovery; if left blank, Groovarr falls back to yt-dlp's built-in search with reduced reliability.
YOUTUBE_API_KEY=
