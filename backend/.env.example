# Copy to .env for local development (not loaded in the container image —
# the container gets these from the environment / docker-compose instead).

# Filesystem layout
CONFIG_DIR=/config
MEDIA_DIR=/music-videos
DOWNLOADS_DIR=/downloads

# HTTP server
PORT=8080
LOG_LEVEL=INFO

# Required: used to derive the at-rest encryption key for stored credentials.
# Generate one yourself, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
GROOVARR_SECRET_KEY=

# Optional, unused placeholders until Phase 2/4
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
